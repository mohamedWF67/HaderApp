meta {
  name: Second attendee downloads the first attendee's certificate
  type: http
  seq: 1
}

get {
  url: {{certUrl}}/certificates/{{certId}}
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{attendee2Token}}
}

tests {
  test("status is 403", function () {
    expect(res.getStatus()).to.equal(403);
  });
  test("says it belongs to another user", function () {
    expect(res.getBody().error).to.include("another user");
  });
}

docs {
  Same route, someone else's certificate id. The backend compares the certificate's owner with the caller.
}

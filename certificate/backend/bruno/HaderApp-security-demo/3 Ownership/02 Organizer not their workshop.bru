meta {
  name: Organizer lists certificates of a workshop they don't run
  type: http
  seq: 2
}

get {
  url: {{certUrl}}/certificates/workshop/{{certWorkshopId}}
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{organizerToken}}
}

tests {
  test("status is 403", function () {
    expect(res.getStatus()).to.equal(403);
  });
}

docs {
  The workshop's organizerId (from the Registration service) must be the caller.
}

meta {
  name: [Registration] INVALID - workshop with 5000 seats
  type: http
  seq: 2
}

post {
  url: {{registrationUrl}}/workshops
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{organizerToken}}
}

body:json {
  {
    "title": "Too big",
    "date": "{{e2eDate}}",
    "totalSeats": 5000
  }
}

tests {
  test("status is 400", function () {
    expect(res.getStatus()).to.equal(400);
  });
}

docs {
  INVALID. Seats must be 1-1000; refused by the validator.
}

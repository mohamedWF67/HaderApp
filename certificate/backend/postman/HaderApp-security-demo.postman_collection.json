    {
      "name": "6. Rate limiting (429) - run LAST",
      "item": [
        {
          "name": "11th verify within a minute is refused",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{certUrl}}/certificates/verify/AAAAAAAAAAAAAAAAAAAA",
            "description": "Per-IP limit of 10 verifications per minute (stops verification codes being guessed). The pre-request script sends 10 first, so one click shows the 429. Wait a minute before using verify again."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 429', () => pm.response.to.have.status(429));",
                  "pm.test('has Retry-After header', () => pm.expect(pm.response.headers.get('Retry-After')).to.be.ok);"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Sends 10 verify requests first, one after another; this request is then the 11th.",
                  "const url = pm.collectionVariables.get('certUrl') + '/certificates/verify/AAAAAAAAAAAAAAAAAAAA';",
                  "let sent = 0;",
                  "function next() { if (sent++ < 10) pm.sendRequest(url, () => next()); }",
                  "next();"
                ]
              }
            }
          ]
        }
      ]
    }

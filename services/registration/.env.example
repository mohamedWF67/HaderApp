# Copy this file to .env for LOCAL development. Never commit .env (it is in .gitignore).
# In AWS, the same names are set as Lambda environment variables instead.

PORT=3001

# Supabase -> Connect -> Transaction pooler -> copy the URI, then use THIS service's own login
# (created by db/006_service_role.sql), not "postgres":  user = hader_registration.PROJECTREF
DATABASE_URL=postgresql://hader_registration.PROJECTREF:YOUR-PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Supabase -> Project Settings -> Data API -> Project URL
SUPABASE_URL=https://PROJECTREF.supabase.co

# The frontend address allowed to call this API from a browser
CORS_ORIGINS=http://localhost:8080

# Supabase CA certificate, so the connection checks it is really Supabase
DB_CA_PATH=certs/prod-ca-2021.crt
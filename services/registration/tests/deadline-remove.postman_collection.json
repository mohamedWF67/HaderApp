    {
      "name": "DL1 Deadline after the workshop starts -> 400",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token_org1}}"
          }
        ],
        "url": "{{baseUrl}}/workshops",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Bad deadline\",\n  \"date\": \"{{date5}}\",\n  \"totalSeats\": 3,\n  \"registrationDeadline\": \"{{date6}}\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 400', () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "DL2 Create workshop with deadline in 3 days",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token_org1}}"
          }
        ],
        "url": "{{baseUrl}}/workshops",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Deadline test\",\n  \"date\": \"{{date5}}\",\n  \"totalSeats\": 1,\n  \"registrationDeadline\": \"{{date3}}\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 201', () => pm.response.to.have.status(201));",
              "pm.test('Deadline returned', () => pm.expect(pm.response.json().registrationDeadline).to.be.a('string'));",
              "pm.collectionVariables.set('dlWorkshop', pm.response.json().workshopId);"
            ]
          }
        }
      ]
    },
    {
      "name": "DL3 Register before the deadline -> 201",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",

        "url": "{{baseUrl}}/workshops/{{dlWorkshop}}/registrations/{{dlReg1}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('Removed, seat given to waiting list', () => { const j = pm.response.json(); pm.expect(j.status).to.eql('removed'); pm.expect(j.seatGivenToWaitlist).to.eql(true); });"
            ]
          }
        }
      ]
    },

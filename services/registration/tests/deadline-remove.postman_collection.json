              "pm.collectionVariables.set('dlReg1', pm.response.json().registrationId);"
            ]
          }
        }
      ]
    },
    {
      "name": "DL4 Organizer closes registration early (deadline = 1 minute ago)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token_org1}}"
          }
        ],
        "url": "{{baseUrl}}/workshops/{{dlWorkshop}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Deadline test\",\n  \"date\": \"{{date5}}\",\n  \"totalSeats\": 2,\n  \"registrationDeadline\": \"{{pastMinute}}\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "DL5 Register after the deadline -> 400 REGISTRATION_CLOSED",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token_att2}}"
          }
        ],
        "url": "{{baseUrl}}/workshops/{{dlWorkshop}}/registrations"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 400', () => pm.response.to.have.status(400));",
              "pm.test('Code', () => pm.expect(pm.response.json().error.code).to.eql('REGISTRATION_CLOSED'));"
            ]
          }
        }
      ]
    },
    {
      "name": "DL6 Clear the deadline (reopen registration)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token_org1}}"
          }
        ],
        "url": "{{baseUrl}}/workshops/{{dlWorkshop}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Deadline test\",\n  \"date\": \"{{date5}}\",\n  \"totalSeats\": 1,\n  \"registrationDeadline\": \"\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('Deadline removed', () => pm.expect(pm.response.json().registrationDeadline).to.eql(null));"
            ]
          }
        }
      ]
    },

{
  "info": {
    "name": "HaderApp - Deadline & Remove attendee",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Tests for the registration deadline and organizer removing an attendee. Users: organizer1, nour, nada, nayera."
  },
  "item": [
    {
      "name": "Login org1 (organizer1)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "apikey",
            "value": "{{supabaseKey}}"
          }
        ],
        "url": "{{supabaseUrl}}/auth/v1/token?grant_type=password",
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"organizer1@hader.test\", \"password\": \"{{testPassword}}\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Logged in', () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set('token_org1', pm.response.json().access_token);"
            ]
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const d = n => new Date(Date.now() + n*24*3600*1000).toISOString();",
              "pm.collectionVariables.set('date5', d(5)); pm.collectionVariables.set('date3', d(3)); pm.collectionVariables.set('date6', d(6));",
              "pm.collectionVariables.set('pastMinute', new Date(Date.now() - 60000).toISOString());"
            ]
          }
        }
      ]
    },

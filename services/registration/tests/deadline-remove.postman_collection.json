    {
      "name": "RM6 Organizer removes attendee 1 -> seat goes to the queue",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token_org1}}"
          }

      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 401', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "NT2 Attendee 2 clears old notifications (mark all read)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token_att2}}"
          }
        ],
        "url": "{{baseUrl}}/notifications/read"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "NT3 Organizer creates a 1-seat workshop",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token_org1}}"
          }
        ],
        "url": "{{baseUrl}}/workshops",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Notification test\",\n  \"date\": \"{{date5}}\",\n  \"totalSeats\": 1\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 201', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('ntWorkshop', pm.response.json().workshopId);"
            ]
          }
        }
      ]
    },
    {
      "name": "NT4 Attendee 1 takes the seat",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token_att1}}"
          }
        ],
        "url": "{{baseUrl}}/workshops/{{ntWorkshop}}/registrations"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 201', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('ntReg1', pm.response.json().registrationId);"
            ]
          }
        }
      ]
    },
    {
      "name": "NT5 Attendee 2 joins the waiting list",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token_att2}}"
          }
        ],
        "url": "{{baseUrl}}/workshops/{{ntWorkshop}}/waitlist"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 201', () => pm.response.to.have.status(201));"
            ]
          }
        }
      ]
    },
    {
      "name": "NT6 Attendee 1 cancels -> seat goes to attendee 2",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token_att1}}"
          }
        ],
        "url": "{{baseUrl}}/registrations/{{ntReg1}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "NT7 Attendee 2 is notified: got the seat (unread)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token_att2}}"
          }
        ],
        "url": "{{baseUrl}}/notifications/me"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "const j = pm.response.json(); const n = j.notifications.find(x => x.workshopId === pm.collectionVariables.get('ntWorkshop') && x.type === 'waitlist_promoted');",
              "pm.test('Has waitlist_promoted notification', () => pm.expect(n, 'notification').to.exist);",
              "pm.test('It is unread', () => { pm.expect(n.read).to.eql(false); pm.expect(j.unread).to.be.above(0); });"
            ]
          }
        }
      ]
    },
    {
      "name": "NT8 Attendee 2 marks all as read",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token_att2}}"
          }
        ],
        "url": "{{baseUrl}}/notifications/read"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('Marked at least 1', () => pm.expect(pm.response.json().markedRead).to.be.above(0));"
            ]
          }
        }
      ]
    },
    {
      "name": "NT9 Unread count is now 0",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token_att2}}"
          }
        ],
        "url": "{{baseUrl}}/notifications/me"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('Unread 0', () => pm.expect(pm.response.json().unread).to.eql(0));"
            ]
          }
        }
      ]
    },

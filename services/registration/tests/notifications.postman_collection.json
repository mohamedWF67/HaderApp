    {
      "name": "NT1 SECURITY No login -> 401",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/notifications/me"

{
  "info": {
    "name": "HaderApp - Notifications",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "In-app notifications created by actions. Users: organizer1, nada, nayera. The scheduled checks are tested by invoking the checks Lambda (see instructions)."
  },
  "item": [
    {
      "name": "Login org1 (organizer1)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "apikey",
            "value": "{{supabaseKey}}"
          }
        ],
        "url": "{{supabaseUrl}}/auth/v1/token?grant_type=password",
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"organizer1@hader.test\", \"password\": \"{{testPassword}}\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Logged in', () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set('token_org1', pm.response.json().access_token);"
            ]
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('date5', new Date(Date.now() + 5*24*3600*1000).toISOString());"
            ]
          }
        }
      ]
    },
    {

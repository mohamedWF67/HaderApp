{
  "info": {
    "name": "HaderApp - Delete & Waiting list v2",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "New tests for DELETE /workshops/{id} and the waiting list. Uses the same 4 test users and password as the main collection."
  },
  "item": [
    {
      "name": "Login org1",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "apikey",
            "value": "{{supabaseKey}}"
          }
        ],
        "url": "{{supabaseUrl}}/auth/v1/token?grant_type=password",
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"organizer1@hader.test\", \"password\": \"{{testPassword}}\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Logged in', () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set('token_org1', pm.response.json().access_token);"
            ]
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('futureDate', new Date(Date.now() + 14*24*3600*1000).toISOString());"
            ]
          }
        }
      ]
    },
